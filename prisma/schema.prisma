// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(true)
  image         String[]
  selactedImg   String?   @default("0")
  phone         String?   @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  // System roles
  roles         Role[]    @default([USER])

  // Profile extensions
  address        String?
  bloodGroup     String?
  coverImg       String?  @default("1")
  whatsappNumber String?
  bio            String?
  skills         String[] @default([])

  // Optional profiles
  member     Member?
  instructor Instructor?

  // Committee roles
  committeeRoles UserCommitteeRole[]

  // Markdown posts written by members, instructors and admins
  posts Post[]

  // Achievements
  achievements Achievement[]

  // LMS Courses
  courseEnrollments CourseEnrollment[]
  lessonProgress    LessonProgress[]

  // Media uploads
  media Media[]

  // Media Templates
  mediaTemplates       MediaTemplate[]
  templateAssignments  MediaTemplateAssignment[]
  assignedToOthers     MediaTemplateAssignment[] @relation("AssignedMediaTemplates")

  // Events
  events             Event[]
  eventRegistrations EventRegistration[]

  // Activity Logs / Audit Trail
  activityLogs       ActivityLog[]

  @@unique([email])
  @@map("user")
}

model Member {
  id     String @id @default(cuid())
  userId String @unique

  status MembershipStatus @default(PENDING)

  joinedAt  DateTime?
  expiresAt DateTime?

  studentId        String? @unique
  boardOrClassRoll String?

  department Department
  session    String
  semester   Semester
  shift      Shift

  studentIdCardUrl String?
  nidorbirthUrl    String?

  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?

  hasPaidMembershipFee Boolean        @default(false)
  paymentMethod        PaymentMethod?
  senderNumber         String?
  transactionId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([session])
  @@index([semester])
  @@index([status])
  @@index([transactionId])
}

model Instructor {
  id     String @id @default(cuid())
  userId String @unique

  instructorId String? @unique

  status InstructorStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonInstructors LessonInstructor[]
}

model Committee {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles CommitteeRole[]
}

model CommitteeRole {
  id String @id @default(cuid())

  committeeId String

  name        String
  slug        String
  description String?

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  users UserCommitteeRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([committeeId, slug])
  @@index([committeeId])
}

model UserCommitteeRole {
  id String @id @default(cuid())

  userId String
  roleId String

  startDate DateTime?
  endDate   DateTime?

  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role CommitteeRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Same user cannot have the same committee role twice
  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ============================================================
// SYSTEM ROLES
// ============================================================

enum Role {
  USER
  MEMBER
  INSTRUCTOR
  ADMIN
  SUPER_ADMIN
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  REJECTED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  HAND_TO_HAND
  CASH
}

enum Department {
  COMPUTER_SCIENCE_AND_TECHNOLOGY
  CIVIL_TECHNOLOGY
  ELECTRICAL_TECHNOLOGY
  ELECTRONICS_TECHNOLOGY
  MECHANICAL_TECHNOLOGY
  POWER_TECHNOLOGY
  RAC_TECHNOLOGY
  ARCHITECTURE_TECHNOLOGY
  FOOD_TECHNOLOGY
  CHEMICAL_TECHNOLOGY
  TELECOMMUNICATION_TECHNOLOGY
  AUTOMOBILE_TECHNOLOGY
  CONSTRUCTION_TECHNOLOGY
  ENVIRONMENTAL_TECHNOLOGY
  GRAPHIC_DESIGN_TECHNOLOGY
  SURVEYING_TECHNOLOGY
  OTHER
}

enum Semester {
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
  SIXTH
  SEVENTH
  EIGHTH
}

enum Shift {
  MORNING
  DAY
}

enum InstructorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model Setting {
  id String @id @default("global")

  isSignupEnabled           Boolean @default(true)
  isMemberSignupEnabled     Boolean @default(true)
  isInstructorSignupEnabled Boolean @default(true)

  isRegistrationFeeRequired Boolean @default(false)
  registrationFee           Int     @default(0)

  bkashPersonalNumber  String?
  bkashAgentNumber     String?
  nagadPersonalNumber  String?
  nagadAgentNumber     String?
  rocketPersonalNumber String?
  rocketAgentNumber    String?

  isAutoStudentIdEnabled Boolean @default(true)
  studentIdPrefix        String  @default("DPICS")
  studentIdBatch         String  @default("26")
  batchMemberLimit       Int     @default(0)

  isAutoInstructorIdEnabled Boolean @default(true)
  instructorIdPrefix        String  @default("INS")

  // SMTP / Email Settings
  smtpHost        String?  @default("smtp.gmail.com")
  smtpPort        Int?     @default(465)
  smtpSecure      Boolean? @default(true)
  smtpUser        String?
  smtpPass        String?
  smtpFromEmail   String?
  smtpFromName    String?  @default("DPI Computing Society")
  isEmailEnabled  Boolean  @default(true)

  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("setting")
}

// ============================================================
// CATEGORIES & TYPES (Reusable across Posts, Projects, etc.)
// ============================================================

enum CategoryType {
  POST
  ACHIEVEMENT
  PROJECT
  EVENT
}

model Category {
  id          String       @id @default(cuid())
  type        CategoryType @default(POST)
  name        String
  nameBn      String?
  slug        String
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  posts        Post[]
  achievements Achievement[]
  events       Event[]

  @@unique([type, slug])
  @@index([type])
  @@map("category")
}

// ============================================================
// POSTS
// ============================================================

/// A markdown article. `content` always holds the markdown source; HTML is
/// rendered on demand, so nothing sanitized is ever persisted.
///
/// `status` is server-managed: authors move a post DRAFT -> PENDING and stop
/// there, only an admin can turn PENDING into PUBLISHED or REJECTED, and an
/// author can no longer edit or delete a post once it has left that queue.
model Post {
  id      String  @id @default(cuid())
  title   String
  titleBn String?

  slug      String  @unique
  excerpt   String?
  excerptBn String?

  /// Markdown source in English and Bangla, rendered by react-markdown through rehype-sanitize.
  content   String
  contentBn String?

  coverImage String?
  ogImage    String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       String[]  @default([])
  isFeatured Boolean   @default(false)

  // ---- workflow (server managed) ----
  status           PostStatus @default(DRAFT)
  massageForAuthor String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  publishedAt      DateTime?

  // ---- seo overrides ----
  seoTitle       String?
  seoDescription String?

  /// Recomputed on every write so listings never have to re-parse the source.
  readingMinutes Int @default(1)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

enum PostStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
  UPDATE
}

// ============================================================
// COURSE & LMS MANAGEMENT
// ============================================================

enum CourseLevel {
  ALL_LEVELS
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELLED
}

model Course {
  id            String      @id @default(cuid())
  title         String
  titleBn       String?
  slug          String      @unique
  excerpt       String?
  excerptBn     String?
  description   String?     @db.Text
  descriptionBn String?     @db.Text
  thumbnail     String?
  level         CourseLevel @default(ALL_LEVELS)
  isFree        Boolean     @default(true)
  price         Int         @default(0)
  discountPrice Int?
  isPublished   Boolean     @default(false)
  featured      Boolean     @default(false)
  tags          String[]    @default([])

  sections    CourseSection[]
  enrollments CourseEnrollment[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, isFree])
  @@index([slug])
  @@map("course")
}

model CourseSection {
  id            String  @id @default(cuid())
  courseId      String
  course        Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  titleBn       String?
  description   String?
  descriptionBn String?
  orderIndex    Int     @default(0)

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, orderIndex])
  @@map("course_section")
}

model Lesson {
  id            String        @id @default(cuid())
  sectionId     String
  section       CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title         String
  titleBn       String?
  description   String?       @db.Text
  descriptionBn String?       @db.Text
  orderIndex    Int           @default(0)
  isPreview     Boolean       @default(false)

  // Video Content
  videoUrl      String?
  videoDuration String?

  // Diverse Content Items (JSON)
  liveClass     Json?
  documents     Json?
  quiz          Json?
  assignment    Json?
  resources     Json?
  externalLinks Json?

  instructors LessonInstructor[]
  progress    LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, orderIndex])
  @@map("course_lesson")
}

model LessonInstructor {
  id           String     @id @default(cuid())
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  role         String?    @default("Instructor")

  createdAt DateTime @default(now())

  @@unique([lessonId, instructorId])
  @@index([lessonId])
  @@index([instructorId])
  @@map("lesson_instructor")
}

model CourseEnrollment {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status        EnrollmentStatus @default(PENDING)
  paymentMethod PaymentMethod?
  senderNumber  String?
  transactionId String?
  amountPaid    Int              @default(0)
  adminNote     String?

  enrolledAt   DateTime  @default(now())
  approvedAt   DateTime?
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, userId])
  @@index([courseId, status])
  @@index([userId])
  @@index([transactionId])
  @@map("course_enrollment")
}

model LessonProgress {
  id          String    @id @default(cuid())
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, userId])
  @@index([lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

// ============================================================
// ACHIEVEMENTS
// ============================================================

model Achievement {
  id      String  @id @default(cuid())
  title   String
  titleBn String?

  slug      String  @unique
  excerpt   String?
  excerptBn String?

  content   String  @db.Text
  contentBn String? @db.Text

  coverImage String?
  images     String[] @default([])

  eventDate      DateTime?
  organization   String?
  organizationBn String?
  certificateUrl String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       String[]  @default([])
  isFeatured Boolean   @default(false)

  // Workflow (reusing PostStatus for consistent moderation)
  status           PostStatus @default(DRAFT)
  massageForAuthor String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  publishedAt      DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([eventDate])
  @@map("achievement")
}

// ============================================================
// MEDIA (ImageKit Integration)
// ============================================================

model Media {
  id           String  @id @default(cuid())
  fileId       String  @unique
  name         String
  url          String
  thumbnailUrl String?
  filePath     String?
  fileType     String? @default("image")
  mimeType     String?
  size         Int     @default(0)
  width        Int?
  height       Int?
  alt          String?
  folder       String? @default("general")

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  templates MediaTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([fileType])
  @@index([createdAt])
  @@map("media")
}

// ============================================================
// DYNAMIC MEDIA TEMPLATES & IMAGE GENERATION
// ============================================================

enum TemplateType {
  MEMBER_CARD
  EVENT_PASS
  CERTIFICATE
  COURSE_CERTIFICATE
  ACHIEVEMENT
  SOCIAL_POST
  ANNOUNCEMENT
  CUSTOM
}

model MediaTemplate {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        TemplateType @default(MEMBER_CARD)

  // Background media asset
  mediaId     String
  media       Media        @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  // Canvas output dimensions in pixels
  width       Int          @default(1080)
  height      Int          @default(680)

  // Normalized element tree JSON (text, images, qr, shapes, lines)
  design      Json

  isActive    Boolean      @default(true)

  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  assignments MediaTemplateAssignment[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([mediaId])
  @@index([createdById])
  @@index([isActive])
  @@map("media_template")
}

model MediaTemplateAssignment {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String
  template     MediaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  assignedById String?
  assignedBy   User?         @relation("AssignedMediaTemplates", fields: [assignedById], references: [id], onDelete: SetNull)

  customData   Json?
  status       String        @default("ACTIVE")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, templateId])
  @@index([userId])
  @@index([templateId])
  @@index([status])
  @@map("media_template_assignment")
}

// ============================================================
// EVENTS & REGISTRATION
// ============================================================

enum EventType {
  IN_PERSON
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventRegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
  REJECTED
}

model Event {
  id         String      @id @default(cuid())
  title      String
  titleBn    String?
  slug       String      @unique
  excerpt    String?
  excerptBn  String?
  content    String      @db.Text
  contentBn  String?     @db.Text
  coverImage String?
  images     String[]    @default([])
  eventType  EventType   @default(IN_PERSON)
  status     EventStatus @default(UPCOMING)

  startDate            DateTime
  endDate              DateTime?
  registrationDeadline DateTime?

  venue          String?
  venueBn        String?
  locationMapUrl String?
  onlineJoinUrl  String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       String[]  @default([])
  isFeatured Boolean   @default(false)

  // Registration & Capacity
  isRegistrationOpen Boolean @default(true)
  isFree             Boolean @default(true)
  registrationFee    Int     @default(0)
  maxParticipants    Int?

  // Structured Guest Speakers / Mentors
  guestSpeakers Json?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startDate])
  @@index([categoryId])
  @@index([authorId])
  @@index([slug])
  @@map("event")
}

model EventRegistration {
  id      String  @id @default(cuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name        String
  email       String
  phone       String
  studentId   String?
  department  Department?
  semester    Semester?
  shift       Shift?
  institution String?

  status     EventRegistrationStatus @default(PENDING)
  ticketCode String                  @unique

  paymentMethod PaymentMethod?
  senderNumber  String?
  transactionId String?
  amountPaid    Int            @default(0)

  notes         String?
  registeredAt  DateTime  @default(now())
  confirmedAt   DateTime?
  confirmedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([userId])
  @@index([ticketCode])
  @@index([email])
  @@map("event_registration")
}

// ============================================================
// EMAIL NOTIFICATIONS & BULK MAILING
// ============================================================

enum EmailLogStatus {
  SENT
  FAILED
  QUEUED
}

enum EmailCategory {
  ENROLLMENT
  MEMBERSHIP
  INSTRUCTOR
  POST
  ACHIEVEMENT
  EVENT
  ACCOUNT
  BULK
  SYSTEM
}

model EmailTemplate {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  category    EmailCategory @default(SYSTEM)
  description String?

  subject     String
  bodyHtml    String        @db.Text
  bodyText    String?       @db.Text

  variables   String[]      @default([])
  isActive    Boolean       @default(true)
  isSystem    Boolean       @default(false)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category])
  @@index([key])
  @@map("email_template")
}

model EmailLog {
  id           String         @id @default(cuid())
  to           String
  recipientName String?
  userId       String?
  templateKey  String?
  subject      String
  category     EmailCategory  @default(SYSTEM)
  status       EmailLogStatus @default(SENT)
  errorMessage String?        @db.Text
  metadata     Json?
  sentAt       DateTime?

  createdAt    DateTime       @default(now())

  @@index([to])
  @@index([templateKey])
  @@index([status])
  @@index([createdAt])
  @@map("email_log")
}

// ============================================================
// AUDIT TRAIL / ACTIVITY LOGS
// ============================================================

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  ROLE_CHANGE
  VERIFICATION
  ENROLLMENT
  LOGIN
  SETTINGS_CHANGE
  BULK_ACTION
  OTHER
}

model ActivityLog {
  id           String         @id @default(cuid())
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String?
  userEmail    String?
  userRole     String?

  action       ActivityAction @default(OTHER)
  actionName   String         // e.g. "USER_UPDATED", "MEMBER_VERIFIED", "COURSE_ENROLLED", "ROLE_ASSIGNED"
  entity       String         // e.g. "User", "Member", "Course", "Post", "Achievement", "Event", "Setting"
  entityId     String?

  description  String?        // Human-readable summary
  oldData      Json?          // Snapshot before mutation
  newData      Json?          // Snapshot after mutation
  metadata     Json?          // Extra context (IP, user agent, filters, count, etc.)

  ipAddress    String?
  userAgent    String?

  createdAt    DateTime       @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([actionName])
  @@index([createdAt])
  @@map("activity_log")
}

